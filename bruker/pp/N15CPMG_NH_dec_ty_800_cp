/*  N15CPMG_NH_dec_ty_800_cp
    Uses [0 0 1 3] phase scheme of Zuiderweg

    This pulse sequence will allow one to perform the following experiment:

    "Constant Relaxation Time CPMG experiment for NH" to identify Rex due to
    (millisecond) motions. The Nitrogen magnetization is inphase because of
    1H decoupling with 90x240y90x pulses.

    2D       F1       15N
             F2(acq)  1H (NH)

    REF: Jiang et al. JMR, Vol 257, 2015
         Hansen et al. JPC B, Vol 112, 2008

    Power levels:
    1H: pl1 - high power 1H pulses
        pl9 - presat
        pl11 - power level for mess purge
        pl12 - power level for 1H decoupling during CPMG

    15N: pl3 - high power 15N pulses
         spw32 - reburp 15N 180o pulse for selective excitation of amide 15Ns (if -DN_sel is set)
         pl33 - power level for 15N CPMG pulses

    Modified by T.Y on Jun 7, 2017:
      1. tauCPMG value adjusted, such that no need to perform post-processing to 
         obtain flat dispersion profile in the absence of slow exchange
      2. d1 delay readjusted when N_comp is used

    Recommemded:
      1. Use -DN_comp for heating compensation if possible
      2. Use -Dcalc_PL to calculate power level for 15N CPMG pulses (~1 dB weaker than pl3)
      3. Calibrate pulse length under load with -DN_calib, p35 (pwn_calib), pl35,
         but MAKE SURE THAT this flag is NOT used in the recording of the data set!

    Modified on Nov 22, 2018 to add '-Dip_flg' option to apply waltz16 1H decoupling
      during t1, 1H carrier is set at amide region during t1

    Modified by TY on Dec 28, 2018 to add option of cp_flg, for performing het-cp
      between H and N for transfers at the beginning and the end

    Modified by TY on Dec 28, 2018 to add option of xy_flg for performing XY-16
      transfer instead of simple INEPT, in order to obtain more signals in the
      presence of slow exchange process

    Modified by TY on Jan 20, 2023 to change [0013]-type phase cycle back to 4-step
      cycle, and add -Dshp_flg option for using shaped pulses in CPMG pulse train

    Modified by TY on Aug 2, 2023 to change 1H decoupling scheme

    Heating compensation for 1H decoupling is performed after the Trelax period
      by default, or before the d1 period with -Dheat_old option

*/

prosol relations=<triple>

#include <Avance.incl>
#include <Grad.incl>
#include <Delay.incl>

/***********************/
/*   Define phases     */
/***********************/
#define zero ph=0.0
#define one ph=90.0
#define two ph=180.0
#define three ph=270.0

/***********************/
/*   Define pulses     */
/***********************/
define pulse dly_pg1     /* Messerle purge pulse */
  "dly_pg1=5m"

define pulse dly_pg2     /* Messerle purge pulse */
  "dly_pg2=dly_pg1/1.62"

define pulse pwh
  "pwh=p1"               /* 1H hard pulse at power level pl1 (tpwr) */

#ifdef c_flg
  define pulse pwc_ad
    "pwc_ad=p8"           /* adiabatic 180 at sp13   */
#endif

"p12=1s/(4.0*cnst2)"

define pulse pwh_dec
  "pwh_dec=p12"

#ifdef xy_flg
  "plw15=plw1*0.8"
  "p15=p1*sqrt(1.25)"

  define pulse pwh_cp
    "pwh_cp=p15"
#endif

#ifdef ip_flg
  define pulse pwh_cpd
    "pwh_cpd=p17"
#endif

#ifdef cp_flg
  define pulse pw_dip
    "pw_dip=p18"
#endif

define pulse pwn
  "pwn=p21"              /* PW90 for N pulse at power level pl3 (dhpwr2)  */

#ifdef N_sel
  define pulse pwn_sl
    "pwn_sl=p32"
#endif

#ifdef calc_PL
  "plw33=plw3*0.8"
  "p33=p21*sqrt(1.25)"
#endif

define pulse pwn_cp
  "pwn_cp=p33"

/************************/
/*   Define delays      */
/************************/
define delay hscuba      /* length of 1/2 scuba delay */
  "hscuba=25m"

define delay time_T2
  "time_T2=d20"

define delay time_eq
  "time_eq=d22"

define delay taua        /* 1 / 4J(XH)                */
  "taua=d25"             /* use JNH=105 to decrease the tauxh duration */

define delay taub        /* 1 / 4J(XH)                */
  "taub=d26"             /* use 1/4J(XH=95Hz)         */

#ifdef cp_flg
  define delay tau_hetcp
#endif

#ifdef ip_flg
  define delay t1_max

  define loopcounter ni
    "ni=td1/2"
#endif

define delay tauCPMG
define delay tauCPMG0
define delay tauCPMG1
define delay tauCPMG2

"d11=30m"
"d12=4u"
"in0=inf1/2"             /* t1/2 increment */
"TAU2=0.2u"

#ifdef xy_flg
  "TAU3=larger(pwh_cp,pwn_cp)*2.0/PI"
  "TAU5=(taua/16.0)-TAU3"
  "TAU6=(taub/16.0)-TAU3"
#endif

#ifdef N_sel
  "DELTA7=taua-2u-p19-d16-pwn_sl*0.475"
  "DELTA8=taub-2u-p19-d16-pwn_sl*0.475-pwn*2.0/PI"
  "DELTA9=DELTA7"
#else /*N_sel*/
#ifdef shp_flg
  "DELTA7=taua-2u-p19-d16-p30*cnst30*0.5"
  "DELTA8=taub-2u-p19-d16-p29*cnst29*0.5-pwn*2.0/PI"
  "DELTA9=taua-2u-p19-d16-p29*cnst29*0.5"
#else /*shp_flg*/
  "DELTA7=taua-2u-p19-d16"
  "DELTA8=taub-2u-p19-d16-pwn*4.0/PI"
  "DELTA9=DELTA7"
#endif /*shp_flg*/
#endif /*N_sel*/

#ifdef ip_flg
#ifdef N_sel
  "DELTA11=taub-2u-10u-4u-2u-p19-d16-pwn_sl*0.475-pwn*2.0/PI"
  "DELTA12=taub-4u-2u-p19-d16-pwn_sl*0.475-10u-pwn*2.0/PI"
#else /*N_sel*/
#ifdef shp_flg
  "DELTA11=taub-2u-10u-4u-2u-p19-d16-p29*cnst29*0.5-pwn*2.0/PI"
  "DELTA12=taub-4u-2u-p19-d16-p29*cnst29*0.5-10u-pwn*2.0/PI"
#else /*shp_flg*/
  "DELTA11=taub-2u-10u-4u-2u-p19-d16-pwn*4.0/PI"
  "DELTA12=taub-4u-2u-p19-d16-10u-pwn*4.0/PI"
#endif /*shp_flg*/
#endif /*N_sel*/
#else /*ip_flg*/
  "DELTA12=taub-4u-2u-p19-d16+pwh*2.0-10u-pwn*2.0/PI"
#endif /*ip_flg*/

/*****************************************************************/
/* f1180: Start t1 at half dwell to get -90/180 phase correction */
/*        in F1 (15N) dim - set zgoptns -Df1180                  */
/*****************************************************************/
#ifdef f1180
  "d0=(in0/2)"
#else
  "d0=(0.2u/2)"
#endif

/*********************/
/*   Define lists    */
/*********************/
define list<loopcounter> ncyc_cp=<$VCLIST>

define loopcounter ncyc_max /* max value of ncyc used */

/******************************************************/
/* Assign cnsts to check validity of parameter ranges */
/******************************************************/
"cnst11=plw11"         /* tpwrmess */
"cnst16=plw16"
"plw12=plw1*pow(p1/p12,2)"

#ifdef ip_flg
  "plw19=plw1*pow(p1/p17,2)"
#endif

#ifdef cp_flg
  "plw18=plw1*pow(p1/p18,2)"
  "plw36=plw3*pow(p21/p18,2)"
  "tau_hetcp=pw_dip*(2590.0/90.0)*l6"
#endif

#ifdef c_flg
  "spoal13=0.5"
  "spoffs13=0"
#endif

#ifdef N_sel
  "spw32=plw3*pow((p21*2.0/p32)/0.07981016,2)"
  "cnst32=spw32"         /* power level for 15N selective pulse */
  "spoal32=0.5"
#endif

"cnst33=plw33"           /* power level for 15N CPMG pulses */

#ifdef shp_flg
  "spw28=plw3"
  "spw29=plw3"
  "spw30=plw3"
  "spoal28=0.5"
  "spoffs28=0"
  "spoal29=0.5"
  "spoffs29=0"
  "spoal30=0.5"
  "spoffs30=0"

  define pulse shp_cp
    "shp_cp=p36*(10000*pwn_cp/0.25s)"
  "spoal36=0.5"
  "spoffs36=0"
  "spw36=plw33"

  "l8=trunc((time_T2*0.5)/(shp_cp*cnst6+pwn_cp*4.0/PI+4u+0.2u))"
#else
  "l8=trunc((time_T2*0.5)/(pwn_cp*1.5+pwn_cp*4.0/PI+4u+0.2u))"
#endif

/**********************/
/* Define CPMG pulses */
/**********************/
#ifdef shp_flg
#define cpmg_11 (shp_cp:sp36 ph11):f3
#define cpmg_12 (shp_cp:sp36 ph12):f3
#define cpmg_13 (shp_cp:sp36 ph13):f3
#define cpmg_14 (shp_cp:sp36 ph14):f3
#else
#define cpmg_11 (pwn_cp*2.0 ph11):f3
#define cpmg_12 (pwn_cp*2.0 ph12):f3
#define cpmg_13 (pwn_cp*2.0 ph13):f3
#define cpmg_14 (pwn_cp*2.0 ph14):f3
#endif
#define CPMG_15N_short if "nsdone%2 == 0" {\n cpmg_11 \n}\n else {\n cpmg_12 \n}
#define CPMG_15N_long if "nsdone%2 == 0" {\n cpmg_13 \n}\n else {\n cpmg_14 \n}

#define DEC_1H_0 (pwh_dec ph29 pwh_dec*2.6667 ph26 pwh_dec ph29):f1
#define DEC_1H_1 (pwh_dec ph17 pwh_dec*2.6667 ph18 pwh_dec ph17):f1
#define DEC_1H_2 (pwh_dec*2.0 ph20):f1
#define DEC_1H_low if "l23 > 2" {\n 0.2u \n DEC_1H_1 \n 0.2u \n}\n else {\n 0.2u \n DEC_1H_0 \n 0.2u \n}
#define DEC_1H_high if "l30 == 0" {\n 0.2u \n DEC_1H_1 \n 0.2u \n}\n else {\n 0.2u \n DEC_1H_2 \n 0.2u \n}

#ifdef xy_flg
#ifdef shp_flg
#define HN_180 (center (pwh_cp ph15 pwh_cp*2.6667 ph16 pwh_cp ph15):f1 (pwn_cp ph15 pwn_cp*2.6667 ph16 pwn_cp ph15):f3)
#else
#define HN_180 (center (pwh_cp*2.0 ph16):f1 (pwn_cp*2.0 ph16):f3)
#endif
#endif

/*****************************************************/
/* Calculate 1H 90x240y90x decoupling pulse interval */
/*****************************************************/
#ifdef shp_flg
  "DELTA5=pwh_dec*4.6667+pwn_cp*2.0/PI+shp_cp*0.5*cnst6+0.4u+0.2u"
  "l11=trunc((time_T2*0.5)/(shp_cp*cnst6+pwh_dec*4.6667+0.4u+0.4u))"
  "l12=trunc((time_T2*0.5)/(shp_cp*cnst6+pwh_dec*2.0+0.4u+0.4u))"
#else
  "DELTA5=pwh_dec*4.6667+pwn_cp*2.0/PI+pwn_cp*0.75+0.4u+0.2u"
  "l11=trunc((time_T2*0.5)/(pwn_cp*1.5+pwh_dec*4.6667+0.4u+0.4u))"
  "l12=trunc((time_T2*0.5)/(pwn_cp*1.5+pwh_dec*2.0+0.4u+0.4u))"
#endif
"l10=trunc((time_T2*0.25)/(DELTA5+2u))"

/************************/
/* Initialize variables */
/************************/
"l2=0"
"l20=0"
"l21=0"
"l22=0"
"l23=0"
"l24=0"
"l25=0"
"l27=0"
"l30=0"

aqseq 321

"acqt0=0"
baseopt_echo

/*******************************/
/* BEGIN ACTUAL PULSE SEQUENCE */
/*******************************/
1 ze
  "ncyc_max=ncyc_cp.max"
  2u
  "l27=trunc(larger((trunc((time_T2 + 2u)/(DELTA5*4.0)))*4.0, (trunc((ncyc_max + 0.3)/4.0))*2.0) + 4 + 0.3)"
  2u

#ifdef shp_flg
  "DELTA2=(shp_cp+4u)*(ncyc_max+4)*2.0"
#else
  "DELTA2=(pwn_cp*2.0+4u)*(ncyc_max+4)*2.0"
#endif
  "DELTA4=pwh_dec*4.6667*l27+4u"
  2u

/**************************************/
/* Check validity of parameter range  */
/**************************************/
  if "cnst2 > 18000 || cnst2 < 3000" {
    2u
    print "error: cnst2 should be in the range of 3-18 kHz !!!"
    goto HaltAcqu
  }

  if "cnst11 > 2.0" {
    2u
    print "error: tpwrmess pl11 too large; < 2W !!!"
    goto HaltAcqu
  }

#ifdef ip_flg
  if "p17 < 30u" {
    2u
    print "error: p17 for 1H decoupling during t1 too short; > 30us !!!"
    goto HaltAcqu
  }
#endif

#ifdef cp_flg
  if "p18 < 30u" {
    2u
    print "error: p18 for het-cp transfer too short; > 30us !!!"
    goto HaltAcqu
  }

  if "abs(tau_hetcp - taub*4.0) > taub*0.5" {
    2u
    print "warning: het-cp transfer time too long or too short, choose a different p18 !!!"
  }
#endif

#ifdef N_sel
  if "cnst32 > 200" {
    2u
    print "error: dpwr2_sl sp32 too large; < 200W !!!"
    goto HaltAcqu
  }
#endif

  if "cnst33 > 300" {
    2u
    print "error: power level for 15N CPMG pulses too large; < 300W !!!"
    goto HaltAcqu
  }

  if "DELTA5 > 500u" {
    2u
    print "error: 15N CPMG pulse or 1H decoupling pulse too long !!!"
    goto HaltAcqu
  }

  if "time_T2 > 80m" {
    2u
    print "error:time_T2 too long; < 80ms !!!"
    goto HaltAcqu
  }

  if "l12 > l10 || l12 > l11" {
    2u
  }

  if "ncyc_max > 200 || ncyc_max > l8 || ncyc_max > l12" {
    2u
    print "error: ncyc_max too large !!!"
    goto HaltAcqu
  }

#ifdef shp_flg
  if "cnst6 < 0 || cnst6 > 1" {
    2u
    print "error: cnst6 should be in the range of 0 and 1 !!!"
    goto HaltAcqu
  }
#endif

  if "d1 < 1.0s" {
    2u
    print "error: d1 too short; > 1.0s !!!"
    goto HaltAcqu
  }

  if "aq > 100m && cnst16 > 0" {
    2u
    print "error: aq too long; < 100ms !!!"
    goto HaltAcqu
  }

#if defined(cp_flg) && defined(xy_flg)
    2u
    print "error: -Dcp_flg and -Dxy_flg should not be used together !!!"
    goto HaltAcqu
#endif

2 d11 do:f3
/************************/
/* Update list pointers */
/************************/
  2u
  "ncyc_cp.idx=l2"
  2u rpp11 rpp12 rpp13 rpp14 rpp15 rpp16 rpp17 rpp18 rpp20 rpp21 rpp22

/******************************************/
/* Continue with checks that are run time */
/******************************************/
  "l20 = trunc((ncyc_cp - 1)*0.5 + 0.3)"
  "l21 = trunc(ncyc_cp + 0.3)"
  "l22 = trunc(ncyc_cp*2.0 - 1 + 0.3)"
  2u

/* Calculate half-interval between CPMG pulses */
  if "l21 > 0" {
    "tauCPMG0 = (time_T2*0.25)/l21"
    2u
#ifdef shp_flg
    "tauCPMG = tauCPMG0 - shp_cp*0.5*cnst6"
#else
    "tauCPMG = tauCPMG0 - pwn_cp*0.75"
#endif
    2u
    "tauCPMG1 = tauCPMG - pwn_cp*2.0/PI"
  }
  else {
    "tauCPMG = 2u"
    "tauCPMG0 = 2u"
    "tauCPMG1 = 2u"
  }
  2u

/* Determine whether 90x240y90x should be applied or not */
  if "tauCPMG - pwh_dec*4.6667*0.5 >= 0.4u" {
    "l30 = 0"
    "DELTA6 = tauCPMG-pwh_dec*4.6667*0.5-0.2u"
  }
  else {
    "l30 = 1"
    "DELTA6 = tauCPMG-pwh_dec-0.2u"
  }

/* Determine the number of blocks to divide into */
  if "l21 > 0" {
    "l23 = trunc((tauCPMG0 - 2u)/DELTA5)"
  }
  else {
    "l23 = 0"
  }
  2u
  "l24 = (trunc(l23*2.0 + 0.3))"

/* Calculate the number of pulses for 1H heat compensation */
  if "l21 > 0" {
    "l25 = trunc(ncyc_max - l21 + 4 + 0.3)"

    if "l23 > 0" {
      "DELTA10 = larger(pwh_dec*4.6667*(l27 - l21*l23*4.0), TAU2)"
    }
    else {
      if "l30 == 0" {
#ifdef heat_old
        "DELTA10 = larger(pwh_dec*4.6667*(l27 - l20 - (l20%2)), TAU2)"
#else
        "DELTA10 = larger(pwh_dec*4.6667*(l27 - l20), TAU2)"
#endif
      }
      else {
#ifdef heat_old
        "DELTA10 = larger(pwh_dec*4.6667*(l27 - l20*3.0/7.0 - (l20%2)), TAU2)"
#else
        "DELTA10 = larger(pwh_dec*4.6667*(l27 - l20*3.0/7.0), TAU2)"
#endif
      }
    }
  }
  else {
    "l20 = 0"
    "l25 = trunc(ncyc_max - 1 + 4 + 0.3)"
    "DELTA10 = pwh_dec*4.6667*l27"
  }
  2u

/* Calculate delays related to 15N heat compensation */
  if "l25 > 0 && time_T2 > 0" {
#ifdef shp_flg
    "tauCPMG2 = (DELTA2*0.25)/l25 - shp_cp*0.5"
#else
    "tauCPMG2 = (DELTA2*0.25)/l25 - pwn_cp"
#endif
  }
  else {
    "tauCPMG2 = 2u"
  }

/* Calculate delays for longitudinal relaxation compensation */
#ifdef shp_flg
  "DELTA3 = larger((ncyc_max - larger(l21, 1)) * shp_cp * 2.0 * (1.0 - cnst6) + 4u, TAU2)"
#else
  "DELTA3 = larger((ncyc_max - larger(l21, 1)) * pwn_cp + 4u, TAU2)"
#endif
  2u

/****************************************************/
/* Heat compensation for 1H decoupling (old scheme) */
/****************************************************/
#ifdef heat_old
  10u fq=cnst1(bf ppm):f1
  4u pl12:f1

  (2u cw ph26):f1
  DELTA10
  2u do:f1

  "DELTA = larger(DELTA4 - DELTA10, TAU2)"
  DELTA

  50u UNBLKGRAD

  2u
  p16:gp1
  d16
#else
  50u UNBLKGRAD
#endif

/*************************************************/
/* Destroy residual 1H magnetization prior to d1 */
/*************************************************/
  10u fq=0(sfo hz):f1
  4u pl1:f1              /* power pl1 for 1H pulses */

  (pwh ph26):f1

  2u
  p16:gp1*0.5
  d16
 
  (pwh ph27):f1
 
  2u
  p16:gp1
  d16
 
  4u BLKGRAD

/****************************************************************/
/* Insert possibility for N heat comp using the Varian approach */
/****************************************************************/
#ifdef N_comp
  4u pl33:f3

  if "l25 > 0" {
11  tauCPMG2
    CPMG_15N_short
    tauCPMG2 ipp11 ipp12
    lo to 11 times l25
  }
  else {
    DELTA2*0.5
  }

  2u rpp11 rpp12

  50u UNBLKGRAD

  2u
  p16:gp1*2.0
  d16

  4u BLKGRAD
#endif

/***********************************************/
/* Presaturation Period                        */
/* Option for Messerle purge zgoptn -Dmess_flg */
/***********************************************/
#ifdef mess_flg
  4u pl11:f1
  (dly_pg1 ph26):f1
  2u
  (dly_pg2 ph27):f1
#endif
 
#ifdef N_comp
  "DELTA1 = d1 - DELTA2"
#else
  "DELTA1 = d1"
#endif /*N_comp*/
  2u

#ifdef fsat
  4u pl9:f1
  DELTA1 cw:f1 ph26
  2u do:f1
  4u pl1:f1
#ifdef fscuba
  hscuba
  (pwh ph26 pwh*2.0 ph27 pwh ph26):f1
  hscuba
#endif /*fscuba*/
#else
  4u pl1:f1
  DELTA1
#endif /*fsat*/
  50u UNBLKGRAD

/****************************************************************/
/* Insert possibility for N heat comp using the Varian approach */
/****************************************************************/
#ifdef N_comp
  4u pl33:f3

  if "l25 > 0" {
12  tauCPMG2
    CPMG_15N_short
    tauCPMG2 ipp11 ipp12
    lo to 12 times l25
  }
  else {
    DELTA2*0.5
  }

  2u rpp11 rpp12

  2u
  p16:gp1*2.0
  d16
#endif

/**********************************************/
/* Eliminate equilibrium magnetization on 15N */
/**********************************************/
  4u pl3:f3
  (pwn ph26):f3

  2u
  p16:gp1
  d16

/**************************/
/* This is the real start */
/**************************/
#ifdef cp_flg
  10u fq=cnst1(bf ppm):f1

  (pwh ph26):f1

  "DELTA=min(d12, d13)"
  DELTA pl18:f1 pl36:f3

3 (center (pw_dip*3.556 ph21):f1 (pw_dip*3.556 ph21):f3)
  (center (pw_dip*4.556 ph22):f1 (pw_dip*4.556 ph22):f3)
  (center (pw_dip*3.222 ph21):f1 (pw_dip*3.222 ph21):f3)
  (center (pw_dip*3.167 ph22):f1 (pw_dip*3.167 ph22):f3)
  (center (pw_dip*0.333 ph21):f1 (pw_dip*0.333 ph21):f3)
  (center (pw_dip*2.722 ph22):f1 (pw_dip*2.722 ph22):f3)
  (center (pw_dip*4.167 ph21):f1 (pw_dip*4.167 ph21):f3)
  (center (pw_dip*2.944 ph22):f1 (pw_dip*2.944 ph22 ipp22):f3)
  (center (pw_dip*4.111 ph21):f1 (pw_dip*4.111 ph21 ipp21):f3)
  lo to 3 times l6

  DELTA pl3:f3
  (pwn ph28):f3
  2u rpp21 rpp22
#else /*cp_flg*/
  (pwh ph26):f1

#ifdef xy_flg
  "TAU7 = TAU5 - pwh*2.0/PI"
  "TAU8 = TAU5*2.0 - 2u"

  TAU7 pl15:f1 pl33:f3 rpp15 rpp16
  HN_180

4 2u ipp15 ipp16
  TAU8
  HN_180
  lo to 4 times 15

  TAU7 pl1:f1 pl3:f3

  (pwh ph29):f1
#else /*xy_flg*/
  2u
  p19:gp2
  d16

  DELTA7

#ifdef N_sel
